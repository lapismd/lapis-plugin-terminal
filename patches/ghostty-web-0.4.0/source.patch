new file mode 100644
index 0000000000..b535b42c59
--- /dev/null
+++ b/lib/default-colors.test.ts
@@ -0,0 +1,23 @@
+import { expect, test } from 'bun:test';
+import { Ghostty } from './ghostty';
+
+test('OSC default colors update existing default cells and preserve explicit colors', async () => {
+  const ghostty = await Ghostty.load();
+  const terminal = ghostty.createTerminal(20, 4, {
+    fgColor: 0x222222,
+    bgColor: 0xffffff,
+  });
+  try {
+    terminal.write('plain \x1b[48;2;255;0;0mred\x1b[0m');
+    terminal.update();
+    terminal.write('\x1b]10;#d4d4d4\x1b\\\x1b]11;#1e1e1e\x1b\\');
+    terminal.update();
+    expect(terminal.getColors().background).toEqual({ r: 30, g: 30, b: 30 });
+    expect(terminal.getColors().foreground).toEqual({ r: 212, g: 212, b: 212 });
+    const line = terminal.getLine(0)!;
+    expect([line[0].bg_r, line[0].bg_g, line[0].bg_b]).toEqual([30, 30, 30]);
+    expect([line[6].bg_r, line[6].bg_g, line[6].bg_b]).toEqual([255, 0, 0]);
+  } finally {
+    terminal.free();
+  }
+});
diff --git a/lib/fit-viewport.test.ts b/lib/fit-viewport.test.ts
new file mode 100644
index 0000000000..037446dd17
--- /dev/null
+++ b/lib/fit-viewport.test.ts
@@ -0,0 +1,32 @@
+import { expect, test } from 'bun:test';
+import { FitAddon } from './addons/fit';
+import { createIsolatedTerminal } from './test-helpers';
+
+test('fit fills the container without a reserved scrollbar gutter or stretched cells', async () => {
+  const terminal = await createIsolatedTerminal();
+  const element = document.createElement('div');
+  let width = 901;
+  Object.defineProperty(element, 'clientWidth', { get: () => width });
+  Object.defineProperty(element, 'clientHeight', { value: 207 });
+  document.body.append(element);
+  const fit = new FitAddon();
+  terminal.loadAddon(fit);
+  try {
+    terminal.open(element);
+    const metrics = terminal.renderer!.getMetrics();
+    fit.fit();
+    expect(terminal.cols).toBe(Math.floor(width / metrics.width));
+    const canvas = element.querySelector('canvas')!;
+    expect(canvas.style.width).toBe('901px');
+    expect(canvas.style.height).toBe('207px');
+    expect(terminal.renderer!.getMetrics()).toEqual(metrics);
+    await new Promise((resolve) => setTimeout(resolve, 55));
+    width = 902;
+    fit.fit();
+    expect(canvas.style.width).toBe('902px');
+    expect(canvas.width).toBe(Math.round(width * window.devicePixelRatio));
+  } finally {
+    terminal.dispose();
+    element.remove();
+  }
+});
