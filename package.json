{
  "name": "@lapis-notes/lapis-plugin-terminal",
  "version": "0.1.1",
  "description": "Lapis Notes interactive terminal panel",
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm spec:validate && pnpm check:app-ownership && pnpm check:svelte && pnpm check:types",
    "check:app-ownership": "vitest run --project unit src/lib/application-ownership.test.ts",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit --passWithNoTests && pnpm test:browser",
    "publint": "publint",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && node scripts/bundle-ghostty.mjs && publint",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check && pnpm check:app-ownership",
    "spec:first": "spec-validator first",
    "spec:index": "spec-validator index",
    "spec:search": "spec-validator search",
    "spec:serve": "spec-validator serve",
    "spec:validate": "spec-validator validate",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "patch:ghostty": "node scripts/regenerate-ghostty-patch.mjs",
    "test:package": "pnpm build && vitest run --config vitest.packaged.config.ts"
  },
  "files": [
    "dist",
    "manifest.json",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ghostty-vt.wasm": "./dist/ghostty-vt.wasm"
  },
  "peerDependencies": {
    "@lapis-notes/api": "^0.2.4 || ^0.4.0 || ^0.6.0",
    "@lapismd/design-core": "^0.12.3 || ^0.13.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@lapis-notes/api": "0.6.5",
    "@lapis-notes/ui": "0.2.5",
    "@lapismd/design-core": "0.13.4",
    "@lapismd/spec-validator": "0.2.1",
    "@sveltejs/package": "2.5.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tsconfig/svelte": "5.0.5",
    "publint": "0.3.12",
    "svelte": "5.56.10",
    "svelte-check": "4.3.1",
    "typescript": "~5.8.3",
    "vite": "6.4.2",
    "vitest": "4.1.8",
    "@playwright/test": "1.64.1",
    "@vitest/browser-playwright": "4.1.8",
    "ghostty-web": "0.4.0",
    "esbuild": "0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugin-terminal.git"
  },
  "homepage": "https://github.com/lapismd/lapis-plugin-terminal#readme",
  "bugs": {
    "url": "https://github.com/lapismd/lapis-plugin-terminal/issues"
  }
}
